# API base URL for the Expo app (used at build/runtime).
# Development – Android emulator (default if unset):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3001

# Development – iOS simulator:
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Production: set to your deployed API URL, e.g.:
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com

# Google Sign-In (optional). Same OAuth 2.0 Web Client ID as admin app. When set, login screen shows "Sign in with Google".
# Add redirect URI to your Web client in Google Cloud: mobile://redirect (dev build) or your custom scheme.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
