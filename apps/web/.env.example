# --- Vercel / production (required in deployment) ---
NEXT_PUBLIC_API_URL=

# Canonical site URL for Open Graph metadata (optional; Vercel sets VERCEL_URL at build time).
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Local: point at your API (no default in code — set this for dev).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Google Sign-In (optional). When set, the admin login page shows "Sign in with Google".
# Use the same OAuth 2.0 Client ID as your API (Web application type) from Google Cloud Console.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
