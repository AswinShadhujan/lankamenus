# API base URL (e.g. for admin login and data fetching)
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Google Sign-In (optional). When set, the admin login page shows "Sign in with Google".
# Use the same OAuth 2.0 Client ID as your API (Web application type) from Google Cloud Console.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
