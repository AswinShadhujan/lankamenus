# Database (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# API (required)
PORT=3001

# Auth (required in production)
JWT_SECRET="your-secret-at-least-32-chars"

# Meilisearch (optional; for Phase 5 full-text search)
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_API_KEY="your-meili-master-key"

# Redis (optional; for caching and server-side sessions / logout)
#
# Option A — URL (recommended; supports password + TLS via rediss://):
#   REDIS_URL="redis://localhost:6379"
#   REDIS_URL="redis://:PASSWORD@host:6379"
#   REDIS_URL="rediss://user:PASSWORD@your-redis.example.com:6380"
#
# Option B — host + port (only when REDIS_URL is empty/unset; plain redis://, no TLS):
#   REDIS_HOST=127.0.0.1
#   REDIS_PORT=6379
#
# GET /restaurants list cache TTL (seconds); max 86400 (24h); defaults in cache-keys.ts
# CACHE_TTL_RESTAURANTS_NEARBY=60
# CACHE_TTL_RESTAURANTS_LIST=120
# CACHE_TTL_RESTAURANTS_DISCOVERY=300
#
# Logs truncate long cache keys (see docs/REDIS-CACHE-LAYER.md).

# CORS (optional; comma-separated origins for production)
# When unset, defaults to localhost dev origins.
# CORS_ORIGINS="https://yourapp.com,https://admin.yourapp.com"

# Node (optional; set to "production" in production for logging and behavior)
# NODE_ENV=production

# Google Sign-In (optional). When set, POST /auth/google can verify Google ID tokens.
# Use the same OAuth 2.0 Web Client ID as the Next.js app (from Google Cloud Console).
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Required for mobile (POST /auth/google/code): same Web client's secret.
# GOOGLE_CLIENT_SECRET=your-client-secret

# Google Places (optional; required for restaurant import script and place photos)
# Get a key from Google Cloud Console with Places API enabled, then set:
GOOGLE_PLACES_API_KEY=
#
# Backfill rating_count from Place Details (existing rows with rating_count=0):
#   pnpm backfill:rating-count
#   pnpm exec ts-node -r dotenv/config scripts/backfill-rating-count.ts -- --limit=100
