# PostGIS required for migrations (Railway: use PostGIS template, not default Postgres — see docs/DEPLOYMENT.md)
DATABASE_URL=
JWT_SECRET=
PORT=

# DATABASE_URL: Postgres connection string (Railway / RDS / Azure Database).
# Intermittent "Can't reach database" (Prisma P1001) on Railway: try longer connect timeout on the URL, e.g.
#   ?sslmode=require&connect_timeout=60
# (append with & if the URL already has query params). Upgrade plan or use regional proxy if overload persists.
# JWT_SECRET: at least 16 characters (validated at startup).
# PORT: optional; platforms like Railway set PORT automatically (see main.ts default 3000).

# Meilisearch (optional)
# MEILISEARCH_HOST=
# MEILISEARCH_API_KEY=

# Redis (optional)
# REDIS_URL=

# Google OAuth / Places (optional) — see previous docs for keys.

# Cloudinary (optional) — banner image uploads (POST /banners/:id/image) and media pipeline.
# Set all three together (sub-account / upload API key is fine). Leave all unset to disable uploads without crashing.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
