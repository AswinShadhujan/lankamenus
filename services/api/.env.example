DATABASE_URL=
JWT_SECRET=
PORT=

# DATABASE_URL: Postgres connection string (Railway / RDS / Azure Database).
# JWT_SECRET: at least 16 characters (validated at startup).
# PORT: optional; platforms like Railway set PORT automatically (see main.ts default 3000).

# Meilisearch (optional)
# MEILISEARCH_HOST=
# MEILISEARCH_API_KEY=

# Redis (optional)
# REDIS_URL=

# Google OAuth / Places (optional) — see previous docs for keys.
