generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model districts {
  id     String   @id
  name   String
  cities cities[]
}

model cities {
  id          Int       @id @default(autoincrement())
  name        String
  district_id String
  latitude    Float
  longitude   Float
  district    districts @relation(fields: [district_id], references: [id])

  @@index([district_id])
  @@index([name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an index with non-default null sort order and requires additional setup for migrations. Visit https://pris.ly/d/default-index-null-ordering for more info.
model restaurants {
  id              Int                       @id @default(autoincrement())
  name_default    String
  city            String?
  district        String?
  address_line1   String?
  cuisine_tags    String[]
  price_level     Int?                      @db.SmallInt
  veg_friendly    Boolean?                  @default(false)
  halal_certified Boolean?                  @default(false)
  geom            Unsupported("geography")?
  created_at      DateTime?                 @default(now()) @db.Timestamptz(6)
  google_place_id String?                   @unique @map("google_place_id")
  latitude        Float?                    @map("latitude")
  longitude       Float?                    @map("longitude")
  rating          Float?                    @map("rating")
  photo_reference String?                   @map("photo_reference")
  /** Primary cover image: Cloudinary upload or external URL via media_assets. */
  media_asset_id  Int?                      @map("media_asset_id")
  category        String?                   @map("category")
  updated_at      DateTime?                 @updatedAt @map("updated_at")
  slug            String?                   @unique @map("slug")
  /// * Number of rating reviews (e.g. Google user count); drives popular_score.
  rating_count    Int                       @default(0) @map("rating_count")
  /// * Denormalized engagement; trending_score. Increment on view tracking later.
  view_count      Int                       @default(0) @map("view_count")
  /// * Denormalized from favourites; kept in sync in FavouritesService.
  favorite_count  Int                       @default(0) @map("favorite_count")
  /// * GENERATED: rating * ln(rating_count + 1) — read-only in DB.
  popular_score   Float?                    @default(dbgenerated("(COALESCE(rating, (0)::double precision) * ln(((GREATEST(rating_count, 0) + 1))::double precision))")) @map("popular_score")
  /// * GENERATED: engagement blend — read-only in DB.
  trending_score  Float?                    @default(dbgenerated("((((COALESCE(view_count, 0))::double precision * (0.4)::double precision) + ((COALESCE(favorite_count, 0))::double precision * (0.4)::double precision)) + ((COALESCE(rating, (0)::double precision) * (GREATEST(rating_count, 0))::double precision) * (0.2)::double precision))")) @map("trending_score")
  favourites            favourites[]
  menus                 menus[]
  restaurant_extra_costs restaurant_extra_costs[]
  media_asset           media_assets?       @relation(fields: [media_asset_id], references: [id], onDelete: SetNull)
  homepage_banners      homepage_banners[]

  @@index([city])
  @@index([district])
  @@index([price_level])
  @@index([popular_score(sort: Desc)])
  @@index([rating(sort: Desc)], map: "restaurants_rating_list_idx")
  @@index([trending_score(sort: Desc)])
}

model menus {
  id            Int             @id @default(autoincrement())
  restaurant_id Int
  name          String
  is_active     Boolean         @default(true)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  menu_sections menu_sections[]
  restaurant    restaurants     @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
}

model menu_sections {
  id         Int          @id @default(autoincrement())
  menu_id    Int
  name       String
  sort_order Int          @default(0)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  menu_items menu_items[]
  menu       menus        @relation(fields: [menu_id], references: [id], onDelete: Cascade)

  @@index([menu_id])
}

model menu_items {
  id                   Int                    @id @default(autoincrement())
  menu_section_id      Int
  name                 String
  description          String?
  price                Decimal?               @db.Decimal(10, 2)
  currency             String?                @default("LKR")
  veg                  Boolean?               @default(false)
  sort_order           Int                    @default(0)
  created_at           DateTime               @default(now())
  updated_at           DateTime               @updatedAt
  ingredients          String[]               @default([])
  rating               Float?                 @map("rating")
  rating_count         Int?                   @default(0) @map("rating_count")
  /// Dish detail views; used by GET /dishes/trending and incremented in MenusService.findOneItem.
  click_count          Int                    @default(0) @map("click_count")
  image_url            String?                @map("image_url")
  /** Primary dish image: Cloudinary upload or external URL via media_assets. */
  media_asset_id       Int?                   @map("media_asset_id")
  is_available         Boolean                @default(true) @map("is_available")
  is_popular           Boolean                @default(false) @map("is_popular")
  is_recommended       Boolean                @default(false) @map("is_recommended")
  menu_section         menu_sections          @relation(fields: [menu_section_id], references: [id], onDelete: Cascade)
  media_asset          media_assets?          @relation(fields: [media_asset_id], references: [id], onDelete: SetNull)
  user_dish_favourites user_dish_favourites[]
  menu_item_portions   menu_item_portions[]

  @@index([menu_section_id])
  @@index([media_asset_id])
}

model menu_item_portions {
  id           Int        @id @default(autoincrement())
  menu_item_id Int        @map("menu_item_id")
  name         String
  price        Decimal    @db.Decimal(10, 2)
  is_available Boolean    @default(true) @map("is_available")
  sort_order   Int        @default(0) @map("sort_order")
  serves       Int?       @map("serves")
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt
  menu_item    menu_items @relation(fields: [menu_item_id], references: [id], onDelete: Cascade)

  @@index([menu_item_id])
}

model restaurant_extra_costs {
  id            Int         @id @default(autoincrement())
  restaurant_id Int
  label         String      @db.VarChar(100)
  rate          Decimal     @db.Decimal(6, 3)
  sort_order    Int         @default(0)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt
  restaurant    restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model users {
  id                   Int                    @id @default(autoincrement())
  email                String                 @unique
  password             String?
  name                 String?
  role                 String                 @default("user")
  created_at           DateTime               @default(now())
  avatar_url           String?                @map("avatar_url")
  auth_providers       auth_providers[]
  favourites           favourites[]
  user_dish_favourites user_dish_favourites[]
}

model auth_providers {
  id          Int      @id @default(autoincrement())
  provider    String
  provider_id String   @map("provider_id")
  user_id     Int      @map("user_id")
  created_at  DateTime @default(now())
  user        users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
  @@index([user_id])
}

model favourites {
  id            Int         @id @default(autoincrement())
  user_id       Int
  restaurant_id Int
  created_at    DateTime    @default(now())
  restaurant    restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  user          users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, restaurant_id])
}

model user_dish_favourites {
  id         Int        @id @default(autoincrement())
  user_id    Int
  dish_id    Int
  created_at DateTime   @default(now())
  user       users      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  menu_items menu_items @relation(fields: [dish_id], references: [id], onDelete: Cascade)

  @@unique([user_id, dish_id])
  @@index([user_id])
  @@index([dish_id])
}

model media_assets {
  id          Int      @id @default(autoincrement())
  /// `cloudinary` | `external_url`
  source_type String   @default("cloudinary") @db.VarChar(20)
  /// Legacy mirror of storage kind; prefer source_type.
  provider    String   @default("cloudinary") @db.VarChar(30)
  public_id   String?  @db.VarChar(255)
  secure_url  String
  width       Int?
  height      Int?
  format      String?  @db.VarChar(20)
  mime_type   String?  @db.VarChar(100)
  alt_text    String?  @db.VarChar(255)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  homepage_banners homepage_banners[]
  restaurants      restaurants[]
  menu_items         menu_items[]

  @@index([public_id])
  @@index([source_type])
}

model homepage_banners {
  id             Int          @id @default(autoincrement())
  title          String       @db.VarChar(200)
  subtitle       String?      @db.VarChar(500)
  cta_label      String?      @db.VarChar(100)
  /// restaurants_list | restaurant_detail | cuisine | custom_url
  cta_type       String?      @db.VarChar(30)
  cta_url        String?      @db.VarChar(500)
  restaurant_id  Int?
  cuisine_key    String?      @db.VarChar(100)
  media_asset_id Int?
  overlay_color  String?      @db.VarChar(30)
  sort_order     Int          @default(0)
  is_active      Boolean      @default(true)
  starts_at      DateTime?
  ends_at        DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  media_asset    media_assets? @relation(fields: [media_asset_id], references: [id], onDelete: SetNull)
  restaurant     restaurants?  @relation(fields: [restaurant_id], references: [id], onDelete: SetNull)

  @@index([is_active, sort_order])
  @@index([cta_type])
  @@index([restaurant_id])
}

/// Checkpoint for resumable restaurant import (tile-based). Completed tiles are skipped on resume.
model import_tiles_progress {
  id         Int       @id @default(autoincrement())
  district   String    @map("district")
  city       String    @map("city")
  tile_lat   Float     @map("tile_lat")
  tile_lng   Float     @map("tile_lng")
  status     String    @map("status")
  scanned_at DateTime? @map("scanned_at") @db.Timestamptz(6)

  @@unique([district, city, tile_lat, tile_lng])
  @@index([status])
}
